<Window x:Class="Velox.App.Views.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Velox.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AddDownloadViewModel}"
        Title="Novo download" Width="640" SizeToContent="Height" MinHeight="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding DownloadCommand}" />
    </Window.InputBindings>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- título -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentGradient}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Foreground="White" />
                    </Border>
                    <TextBlock Text="Novo download" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Border Background="{StaticResource Accent2SoftBrush}" CornerRadius="7" Padding="8,2" Margin="12,0,0,0"
                            VerticalAlignment="Center" Visibility="{Binding SourceLabel, Converter={StaticResource NullToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="11" Foreground="{StaticResource Accent2Brush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SourceLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent2Brush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource TitleBarButton}" Command="{Binding CancelCommand}" HorizontalAlignment="Right"
                        Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <!-- conteúdo -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,4,22,8">

                <!-- modo -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center">
                        <Run Text="Link" />
                    </TextBlock>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsBatch}" HorizontalAlignment="Right"
                              FontSize="12" Content="Vários links (um por linha)" Foreground="{StaticResource MutedBrush}" />
                </Grid>

                <!-- link único -->
                <Grid Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}">
                    <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                             Tag="https://exemplo.com/arquivo.zip" Padding="12,10,44,10" />
                    <Button Style="{StaticResource IconButton}" Command="{Binding PasteCommand}" HorizontalAlignment="Right"
                            Margin="0,0,4,0" Width="32" Height="32" ToolTip="Colar da área de transferência">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="14" />
                    </Button>
                </Grid>

                <!-- vários links -->
                <Grid Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}">
                    <TextBox Text="{Binding BatchUrls, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}"
                             Tag="Cole os links aqui, um por linha" Height="130" Padding="12,10" />
                    <Button Style="{StaticResource IconButton}" Command="{Binding PasteCommand}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,4,4,0" Width="32" Height="32" ToolTip="Colar">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="14" />
                    </Button>
                    <TextBlock Text="{Binding BatchCountText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"
                               VerticalAlignment="Bottom" Margin="0,0,12,8" />
                </Grid>

                <!-- resultado da sondagem -->
                <Border Margin="0,10,0,0" CornerRadius="10" Padding="12,10" BorderThickness="1"
                        Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProbeState}" Value="idle">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProbeState}" Value="error">
                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProbeState}" Value="ok">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="28" Height="28" VerticalAlignment="Top" Margin="0,0,12,0">
                            <!-- spinner -->
                            <Border x:Name="Spinner" Width="20" Height="20" CornerRadius="10" BorderThickness="2.5"
                                    BorderBrush="{StaticResource Accent2Brush}" Opacity="0.9"
                                    Visibility="{Binding IsProbing, Converter={StaticResource BoolToVis}}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,20,10" />
                                </Border.Clip>
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="SpinRot" />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinRot" Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="16" Foreground="{StaticResource SuccessBrush}"
                                       Visibility="{Binding ProbeOk, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA39;" FontSize="16" Foreground="{StaticResource DangerBrush}"
                                       Visibility="{Binding ProbeError, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProbeMessage}" FontSize="12.5" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding ProbeOk, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ProbeSizeText}" Style="{StaticResource Muted}" FontWeight="SemiBold" />
                                <TextBlock Text="  •  " Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding ProbeTypeText}" Style="{StaticResource Muted}" />
                                <TextBlock Text="  •  " Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding ProbeHostText}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- link decifrado -->
                <Border Margin="0,10,0,0" CornerRadius="10" Padding="12,10" BorderThickness="1"
                        Background="{StaticResource Accent2SoftBrush}" BorderBrush="{StaticResource Accent2Brush}"
                        Visibility="{Binding HasResolvedUrl, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="15" Foreground="{StaticResource Accent2Brush}"
                                   VerticalAlignment="Top" Margin="0,2,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ResolvedText}" FontSize="12.5" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ResolvedUrl}" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding ResolvedUrl}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- nome do arquivo -->
                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Salvar como" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Tag="nome-do-arquivo.ext" />
                </StackPanel>

                <!-- pasta -->
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Pasta de destino" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Command="{Binding BrowseCommand}" Margin="8,0,0,0" Padding="12,0" ToolTip="Escolher pasta">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Procurar" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- categoria -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}" />
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Chip}" GroupName="Cat" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- conexões -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Conexões paralelas" Style="{StaticResource FieldLabel}" Margin="2,0,0,0" />
                            <TextBlock Text="{Binding ConnectionsText}" Style="{StaticResource Muted}" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent2Brush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="1" Maximum="32" Value="{Binding Connections}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartImmediately}"
                              Content="Iniciar agora" Margin="24,14,0,0" VerticalAlignment="Center" FontSize="12.5" />
                </Grid>

                <!-- avançado -->
                <ToggleButton IsChecked="{Binding ShowAdvanced}" Margin="0,10,0,0" HorizontalAlignment="Left" Cursor="Hand"
                              Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource MutedBrush}"
                              FocusVisualStyle="{x:Null}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <TextBlock x:Name="Chev" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Text="Opções avançadas" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chev" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Referer" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Referer, UpdateSourceTrigger=PropertyChanged}" Tag="https://site-de-origem.com" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hash esperado (MD5 / SHA-1 / SHA-256)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ExpectedHash, UpdateSourceTrigger=PropertyChanged}" Tag="opcional — verifica ao concluir"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Cabeçalhos HTTP extras (Nome: valor, um por linha — ex.: Cookie, Authorization)"
                               Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                    <TextBox Text="{Binding HeadersText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}"
                             Tag="Cookie: sessao=abc123" Height="74" Padding="12,8" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- rodapé -->
            <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="22,14">
                <Grid>
                    <TextBlock Text="Ctrl+Enter para baixar" Style="{StaticResource Muted}" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedStrongBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}" Padding="16,9" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding DownloadCommand}" Margin="10,0,0,0" MinWidth="130" AutomationProperties.Name="Baixar">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" Margin="0,0,9,0" />
                                <TextBlock Text="Baixar" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
