<Window x:Class="Velox.App.Views.BypassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Velox.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:BypassViewModel}"
        Title="Decifrar link" Width="700" Height="620" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="Return" Command="{Binding ResolveCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="StatusDot" TargetType="Border">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{StaticResource MutedStrongBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="busy">
                    <Setter Property="Background" Value="{StaticResource Accent2Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="error">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- título -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentGradient}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Foreground="White" />
                    </Border>
                    <TextBlock Text="Decifrar link" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="encurtadores · safelinks · redirecionadores" Foreground="{StaticResource MutedStrongBrush}" FontSize="12"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource TitleBarButton}" Click="Close_Click" HorizontalAlignment="Right"
                        Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE8BB;" />
                </Button>
            </Grid>

            <!-- entrada -->
            <StackPanel Grid.Row="1" Margin="22,4,22,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="https://shrinkme.click/xxxxxx" Padding="12,10,44,10" />
                        <Button Style="{StaticResource IconButton}" Command="{Binding PasteCommand}" HorizontalAlignment="Right"
                                Margin="0,0,4,0" Width="32" Height="32" ToolTip="Colar">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding ResolveCommand}" Margin="10,0,0,0" MinWidth="130"
                            AutomationProperties.Name="Decifrar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="Decifrar" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                    <Border Style="{StaticResource StatusDot}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!-- corpo -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="22,10,22,6">
                <StackPanel>

                    <!-- resultado -->
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14" Margin="0,4,0,12"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="DESTINO" Foreground="{StaticResource SuccessBrush}" FontSize="10.5" FontWeight="Bold" />
                                <TextBlock Text="{Binding ResultKindText}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            </Grid>
                            <TextBox Text="{Binding FinalUrl, Mode=OneWay}" IsReadOnly="True" Margin="0,8,0,0" FontSize="12.5"
                                     FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Style="{StaticResource MultilineTextBox}"
                                     MaxHeight="90" Padding="10,8" />
                            <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource MutedStrongBrush}" FontSize="11.5" Margin="2,8,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding SummaryText, Converter={StaticResource NullToVis}}" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding DownloadCommand}" Margin="0,0,8,6" Padding="14,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Baixar com Velox" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CopyCommand}" Margin="0,0,8,6" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Copiar" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenCommand}" Margin="0,0,8,6" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Abrir no navegador" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- precisa do navegador -->
                    <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14" Margin="0,4,0,12"
                            Visibility="{Binding NeedsBrowser, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Este site exige um captcha validado pelo servidor. O Velox não resolve captchas — abra o link no navegador, conclua a verificação e cole aqui o link final."
                                       TextWrapping="Wrap" FontSize="12.5" />
                            <Button Command="{Binding OpenOriginalCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Abrir no navegador" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- passos -->
                    <TextBlock Text="PASSOS" Style="{StaticResource FieldLabel}" Foreground="{StaticResource MutedStrongBrush}" FontSize="10.5"
                               Visibility="{Binding Steps.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BypassStepItem}">
                                <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Index}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Resolver}" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Url}" Foreground="{StaticResource MutedStrongBrush}" FontSize="11.5"
                                                       FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Url}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" Foreground="{StaticResource MutedStrongBrush}" FontSize="11" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- log -->
                    <TextBlock Text="LOG" Style="{StaticResource FieldLabel}" Foreground="{StaticResource MutedStrongBrush}" FontSize="10.5" Margin="2,10,0,6"
                               Visibility="{Binding LogLines.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                           TextTrimming="CharacterEllipsis" Margin="2,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- rodapé -->
            <Border Grid.Row="3" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="22,12">
                <Grid>
                    <TextBlock Text="Sem captcha automático: se o site exigir, o Velox avisa e abre no navegador." Style="{StaticResource Muted}"
                               Foreground="{StaticResource MutedStrongBrush}" VerticalAlignment="Center" FontSize="11.5" />
                    <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}" Padding="16,9"
                            HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
