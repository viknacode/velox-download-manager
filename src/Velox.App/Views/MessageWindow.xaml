<Window x:Class="Velox.App.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <StackPanel>
            <Grid Margin="22,22,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBg" Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconTb" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="18"
                               Foreground="{StaticResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,2,0,0">
                    <TextBlock x:Name="TitleTb" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageTb" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               LineHeight="19" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,22,22,20"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="Cancelar" Click="Cancel_Click" Style="{StaticResource GhostButton}" Padding="16,9" IsCancel="True" />
                <Button x:Name="ConfirmBtn" Click="Confirm_Click" Margin="10,0,0,0" MinWidth="110" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
