<UserControl x:Class="Velox.App.Views.BypassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Velox.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:BypassViewModel}"
             d:DesignWidth="1000" d:DesignHeight="720">

    <UserControl.Resources>
        <Style x:Key="StatusDot" TargetType="Border">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{StaticResource MutedStrongBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="busy">
                    <Setter Property="Background" Value="{StaticResource Accent2Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="error">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedStrongBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,14,26,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentGradient}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="18" Foreground="White" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Decifrador de links" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Encurtadores, safelinks e redirecionadores → link de destino, sem timers nem anúncios"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Sem captcha automático — se o site exigir, o Velox avisa e abre no navegador."
                       Foreground="{StaticResource MutedStrongBrush}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- entrada -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="18,16" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="https://shrinkme.click/xxxxxx" Padding="12,10,44,10" FontSize="13.5">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ResolveCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource IconButton}" Command="{Binding PasteCommand}" HorizontalAlignment="Right"
                                Margin="0,0,4,0" Width="32" Height="32" ToolTip="Colar">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding ResolveCommand}" Margin="10,0,0,0" MinWidth="130"
                            AutomationProperties.Name="Decifrar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="Decifrar" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Margin="6,0,0,0" Padding="12,8"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Content="Parar" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}" Margin="6,0,0,0" Padding="12,8"
                            Visibility="{Binding IsBusy, Converter={StaticResource InvBoolToVis}}" Content="Limpar" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                    <Border Style="{StaticResource StatusDot}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- corpo: resultado + passos | histórico -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">

                    <!-- resultado -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="18,16" Margin="0,0,0,12"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="LINK DE DESTINO" Foreground="{StaticResource SuccessBrush}" FontSize="10.5" FontWeight="Bold" />
                                <TextBlock Text="{Binding ResultKindText}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"
                                           TextTrimming="CharacterEllipsis" MaxWidth="460" />
                            </Grid>
                            <TextBox Text="{Binding FinalUrl, Mode=OneWay}" IsReadOnly="True" Margin="0,10,0,0" FontSize="13"
                                     FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Style="{StaticResource MultilineTextBox}"
                                     MaxHeight="96" Padding="12,9" />
                            <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource MutedStrongBrush}" FontSize="11.5" Margin="2,8,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding SummaryText, Converter={StaticResource NullToVis}}" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding DownloadCommand}" Margin="0,0,8,6" Padding="16,8"
                                        AutomationProperties.Name="Baixar com Velox">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Baixar com Velox" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CopyCommand}" Margin="0,0,8,6" Padding="14,8" AutomationProperties.Name="Copiar link">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Copiar link" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenCommand}" Margin="0,0,8,6" Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Abrir no navegador" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- precisa do navegador -->
                    <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="18,16" Margin="0,0,0,12"
                            Visibility="{Binding NeedsBrowser, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Este site exige um captcha validado pelo servidor. O Velox não resolve captchas — abra o link no navegador, conclua a verificação e cole aqui o link final."
                                       TextWrapping="Wrap" FontSize="12.5" />
                            <Button Command="{Binding OpenOriginalCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Abrir no navegador" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- estado vazio -->
                    <Border Padding="24" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="idle">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="COMO FUNCIONA" Style="{StaticResource SmallLabel}" Margin="0,0,0,10" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12.5" LineHeight="20"
                                       Text="O Velox abre o link, reconhece o tipo de portão pelo conteúdo da página (AdLinkFly, WP Safelink, redirecionamentos) e reproduz apenas as requisições necessárias — pulando contadores, anúncios e páginas intermediárias. O resultado fica no histórico ao lado, com Copiar e Baixar." />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedStrongBrush}" FontSize="12" Margin="0,10,0,0"
                                       Text="Suportados: shrinkme.click · shrinkme.io · shrinkearn · clk.sh · gplinks · droplink e outros sites do mesmo script; safelinks WP; meta refresh e redirecionamentos por JavaScript." />
                        </StackPanel>
                    </Border>

                    <!-- passos -->
                    <TextBlock Text="PASSOS" Style="{StaticResource SmallLabel}" Margin="2,4,0,8"
                               Visibility="{Binding Steps.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BypassStepItem}">
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Index}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Resolver}" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Url}" Foreground="{StaticResource MutedStrongBrush}" FontSize="11.5"
                                                       FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Url}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" Foreground="{StaticResource MutedStrongBrush}" FontSize="11" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- log -->
                    <TextBlock Text="LOG" Style="{StaticResource SmallLabel}" Margin="2,10,0,6"
                               Visibility="{Binding LogLines.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                           TextTrimming="CharacterEllipsis" Margin="2,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- histórico -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,14,14,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="13" Foreground="{StaticResource Accent2Brush}" Margin="0,0,8,0" />
                            <TextBlock Text="HISTÓRICO" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ClearHistoryCommand}" Content="Limpar" Padding="8,3"
                                FontSize="11" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="Os links decifrados ficam aqui, com Copiar e Baixar." Foreground="{StaticResource MutedStrongBrush}"
                               FontSize="12" Margin="18,20,18,0" TextWrapping="Wrap"
                               Visibility="{Binding HasHistory, Converter={StaticResource InvBoolToVis}}" />

                    <ListBox ItemsSource="{Binding History}" Style="{StaticResource CardList}" Padding="10,0,10,10"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BypassHistoryItem}">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding OriginalHost}" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="→" Foreground="{StaticResource MutedStrongBrush}" Margin="6,0" FontSize="12" />
                                            <TextBlock Text="{Binding FinalHost}" FontSize="12.5" Foreground="{StaticResource Accent2Brush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding WhenText}" Foreground="{StaticResource MutedStrongBrush}" FontSize="10.5" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding FinalUrl}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding FinalUrl}" />
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="{Binding KindText}" Foreground="{StaticResource MutedStrongBrush}" FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150" HorizontalAlignment="Left" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}" Width="30" Height="30" Command="{Binding CopyCommand}" ToolTip="Copiar link">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="30" Height="30" Command="{Binding DownloadCommand}" ToolTip="Baixar com Velox">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Foreground="{StaticResource Accent2Brush}" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="30" Height="30" Command="{Binding OpenCommand}" ToolTip="Abrir no navegador">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="30" Height="30" Command="{Binding ReuseCommand}" ToolTip="Decifrar de novo">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource DangerIconButton}" Width="30" Height="30" Command="{Binding RemoveCommand}" ToolTip="Remover do histórico">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
