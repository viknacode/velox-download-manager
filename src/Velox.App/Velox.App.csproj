<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VeloxDM</AssemblyName>
    <RootNamespace>Velox.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Velox.App.Program</StartupObject>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>Velox Download Manager</Product>
    <AssemblyTitle>Velox Download Manager</AssemblyTitle>
    <Version>1.0.0</Version>
    <Company>Velox</Company>
    <Copyright>Velox</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- evita ambiguidade entre System.Windows (WPF) e System.Windows.Forms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Velox.Core\Velox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- extensão do navegador distribuída junto com o app (pasta "extension" ao lado do exe) -->
    <None Include="..\..\browser-extension\**" Exclude="..\..\browser-extension\**\.*"
          Link="extension\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
